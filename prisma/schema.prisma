generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id           Int    @id @default(autoincrement())
  service_name String
  combo        String

  @@index([service_name])
}

model User {
  user_id               String    @id
  username              String?
  avatar                String?
  is_admin              Boolean   @default(false)
  last_time_genned      String?
  amount_genned         Int       @default(0)
  prem_amount_genned    Int       @default(0)
  is_blacklisted        Boolean   @default(false)
  custom_cooldown       Json      @default("{}")
  user_cooldown         Json      @default("{}")
  subscription_time_left Float?
  subscription_stage    String    @default("Free")
  notes                 String?
  created_at            DateTime  @default(now())

  generation_history  GenerationHistory[]
  giveaway_entries    GiveawayEntry[]
  pending_generations PendingGeneration[]
  ad_impressions     AdImpression[]
  giveaway_wins      GiveawayWin[]
}

model GenerationHistory {
  id           Int      @id @default(autoincrement())
  user_id      String
  service_name String
  combo        String
  is_premium   Boolean  @default(false)
  source       String   @default("generation") // generation | giveaway
  giveaway_id  Int?
  generated_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([source])
}

model Giveaway {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  service_name  String
  account_count Int            @default(1)
  is_premium    Boolean        @default(false)
  created_at    DateTime       @default(now())
  ends_at       DateTime
  is_active     Boolean        @default(true)
  winner_ids    String?

  entries GiveawayEntry[]
}

model GiveawayEntry {
  id          Int      @id @default(autoincrement())
  giveaway_id Int
  user_id     String
  entered_at  DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveaway_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([giveaway_id, user_id])
}

model ServiceConfig {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  display_name String?
  icon_url     String?
  is_active    Boolean @default(true)
}

model PendingGeneration {
  id           Int      @id @default(autoincrement())
  token        String   @unique
  user_id      String
  service_name String
  account_id   Int      @unique
  is_premium   Boolean  @default(false)
  created_at   DateTime @default(now())
  claimable_at DateTime
  expires_at   DateTime

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
  @@index([expires_at])
}

model AdImpression {
  id          Int      @id @default(autoincrement())
  user_id     String
  service_name String
  provider    String   @default("propeller")
  zone_id     String?
  completed   Boolean  @default(false)
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
}

model SiteSettings {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
}

model RateLimit {
  key      String   @id
  count    Int      @default(0)
  reset_at DateTime
}

model GiveawayWin {
  id           Int      @id @default(autoincrement())
  user_id      String
  giveaway_id  Int
  title        String
  service_name String
  combo        String
  is_premium   Boolean  @default(false)
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([created_at])
}
