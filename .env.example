# Discord OAuth (create at https://discord.com/developers)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Guild config
DISCORD_GUILD_ID=
ADMIN_ROLE_IDS=

# Database (auto-set by Vercel when you add Postgres storage)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Cooldown defaults (seconds)
DEFAULT_FREE_COOLDOWN=600
DEFAULT_PREMIUM_COOLDOWN=60

# Role-based cooldowns (JSON string)
ROLE_CONFIG=[{"id":"123","free_cooldown":600,"premium_cooldown":300,"gen_access":["all"],"remove_if_expired":false}]

# Ads
AD_SLOT_ENABLED=false
NEXT_PUBLIC_AD_SLOT_ENABLED=false
